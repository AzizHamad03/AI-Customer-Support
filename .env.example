# Local development example.
# Copy to .env only for a new installation.
# Never overwrite an existing .env containing working credentials.

DEBUG=True

# Generate a unique key using the command in README.md.
# Keep the real key stable across server restarts.
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL is required.
# DATABASE_URL and a SQLite fallback are not supported.
DB_NAME=customer_support
DB_USER=customer_support_user
DB_PASSWORD=replace_with_your_database_password
DB_HOST=localhost
DB_PORT=5432

# Enter your own key in .env, never in this example file.
OPENAI_API_KEY=

CHAT_MODEL=gpt-4.1-mini

# EMBEDDING_MODEL is configured in config/settings.py.
# It is not read from an environment variable.

# Maximum cosine distance accepted for retrieved passages.
# Lower values are stricter. Selected using the development benchmark.
RETRIEVAL_MAX_DISTANCE=0.80